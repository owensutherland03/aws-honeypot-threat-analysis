# Template only. Copy to `.env` ON THE HONEYPOT HOST and fill in real values.
# `.env` is gitignored. Never put real values in this file.
#
#   cp .env.example .env && chmod 600 .env

# --- Phase 4: Grafana Cloud log shipping ---
# Not stored here: the Alloy token lives in /etc/alloy/loki_token (root:alloy 0640)
# and the push URL / user ID are filled into /etc/alloy/config.alloy on the host.

# --- Phase 6: abuse reporting ---
# See reporter/reporter.env.example. The real file is /etc/honeypot-reporter/reporter.env
# on the host (root:hpreporter 0640); the API key never enters the repo.
