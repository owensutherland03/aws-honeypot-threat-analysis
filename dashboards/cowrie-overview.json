            "uid": "${DS_LOKI}"
          },
          "expr": "topk(15, sum by (input) (count_over_time({job=\"cowrie\", eventid=\"cowrie.command.input\"} | json | __error__=\"\" | input!=\"\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "input": "Command",
              "Value #A": "Count"
            },
            "indexByName": {
              "input": 0,
              "Value #A": 1
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Count",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 13
    },
    {
      "type": "table",
      "title": "SSH client versions",
      "description": "SSH client banner: identifies the attack tool (Go, libssh, paramiko, PuTTY...).",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "topk(15, sum by (version) (count_over_time({job=\"cowrie\", eventid=\"cowrie.client.version\"} | json | __error__=\"\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "version": "Client version",
              "Value #A": "Count"
            },
            "indexByName": {
              "version": 0,
              "Value #A": 1
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Count",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 14
    },
    {
      "type": "table",
      "title": "HASSH fingerprints",
      "description": "Hash of the SSH client's algorithm preferences. Fingerprints the tool even when IPs rotate.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "topk(15, sum by (hassh) (count_over_time({job=\"cowrie\", eventid=\"cowrie.client.kex\"} | json | __error__=\"\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "hassh": "HASSH",
              "Value #A": "Count"
            },
            "indexByName": {
              "hassh": 0,
              "Value #A": 1
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Count",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 15
    },
    {
      "type": "logs",
      "title": "Recent commands",
      "description": "Live feed of attacker commands.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{job=\"cowrie\", eventid=\"cowrie.command.input\"} | json | line_format \"{{.src_ip}}  [{{.protocol}}]  {{.input}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "id": 16
    },
    {
      "type": "logs",
      "title": "Downloads (URL + SHA-256)",
      "description": "Malware fetch attempts. Look up the SHA-256 on VirusTotal; never download the sample to your own device.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{job=\"cowrie\", eventid=~\"cowrie.session.file_(download|upload)\"} | json | line_format \"{{.src_ip}}  {{.url}}  sha256={{.shasum}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "id": 17
    }
  ]
}