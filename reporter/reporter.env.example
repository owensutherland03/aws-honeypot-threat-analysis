# Template for /etc/honeypot-reporter/reporter.env  (root:hpreporter 0640)
# NEVER commit the real file. The API key is written with `read -s` (see Phase 6 doc).
# Note: systemd EnvironmentFile does not allow comments at the end of a line.

ABUSEIPDB_API_KEY=

# Flip to false only after reviewing dry-run output
REPORTER_DRY_RUN=true

# This honeypot's Elastic IP (never reported)
SENSOR_IP=203.0.113.10

# Report each IP at most once per day
COOLDOWN_HOURS=24

# Each 15-minute run looks at the last hour
LOOKBACK_HOURS=1

# Rate caps (AbuseIPDB free tier: 1,000 reports/day)
MAX_PER_RUN=50
MAX_PER_DAY=900
